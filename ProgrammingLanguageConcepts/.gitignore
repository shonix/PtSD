*~
.vs
.DS_Store

# Do not include LaTeX generated files.
plc3rd/*.aux
plc3rd/*.idx
plc3rd/*.log
plc3rd/*.toc

# Do not include xfig generated files.
plc3rd/figs/*.bak
plc3rd/figs/*-eps-converted-to.pdf

plcFSharp/Intro/*.class

plcFSharp/Intcomp/*.class
plcFSharp/Intcomp/*.pdf

plcFSharp/Usql/UsqlLex.fsi
plcFSharp/Usql/UsqlPar.fsi
