%{
 (* File microJ/JPar.fsy 
    Parser for a Java like language (micro-Java)
    sestoft@itu.dk, nh@itu.dk * 2025-05-18
  *)

open Absyn;

// Calcuate line and column number given position annotation on tokens.
// Used in JPar.fsy
let ofLexPos (p: FSharp.Text.Lexing.Position) =
  { line = p.Line+1;     // First line is 1.
    column = p.Column }

%}

%token <int> CSTINT
%token <string> CSTSTRING NAME
%token <bool> CSTBOOL

%token CLASS EXTENDS ELSE FOR IF NEW NULL RETURN
%token BOOL INT STRING
%token VOID WHILE
%token PLUS MINUS TIMES DIV MOD
%token EQ NE GT LT GE LE
%token NOT SEQOR SEQAND
%token LPAR RPAR LBRACE RBRACE SEMICOLON COMMA DOT ASSIGN 
%token EOF

%right ASSIGN           /* lowest precedence */
%left SEQOR
%left SEQAND
%left EQ NE 
%left GT LT GE LE
%left PLUS MINUS
%left TIMES DIV MOD 
%nonassoc NOT
%left DOT               /* highest precedence  */

%start Main
%type <Absyn.program> Main

%%

Main:
    Classdecs EOF                       { Program $1 }
;

Classdecs:
    /* empty */                         { [] }
  | Classdec Classdecs                  { $1 :: $2 }
;

Classdec:
    CLASS NAME LBRACE Memberdecs RBRACE { Classdec($2, "Object", $4, ofLexPos(parseState.InputStartPosition 2)) }   
  | CLASS NAME EXTENDS NAME LBRACE Memberdecs RBRACE    
                                        { Classdec($2, $4, $6, ofLexPos(parseState.InputStartPosition 2)) }
;

Memberdecs:
    /* empty */                         { [] }
  | Memberdec Memberdecs                { $1 :: $2 }
;

Memberdec: 
    Methoddec                           { $1 }
  | Fielddec                            { $1 }
;

Fielddec:
    Type NAME SEMICOLON                 { Fielddec($1, $2, ofLexPos(parseState.InputStartPosition 2)) }
;

Methoddec:
    Type NAME LPAR Paramdecs RPAR Block { Methoddec($1, $2, $4, $6, ofLexPos(parseState.InputStartPosition 2)) }
;

Paramdecs:
    /* empty */                         { [] }
  | Paramdecs1                          { $1 }
;

Paramdecs1:
    Paramdec                            { [$1] }
  | Paramdec COMMA Paramdecs1           { $1 :: $3 }
;

Paramdec:
    Type NAME                           { ($1, $2) }
;

Block:
    LBRACE StmtOrDecSeq RBRACE          { Block($2,ofLexPos(parseState.InputStartPosition 2)) }
;

StmtOrDecSeq:
    /* empty */                                     { []                   }
  | Stmt StmtOrDecSeq                               { Stmt $1 :: $2        }
  | Type NAME SEMICOLON StmtOrDecSeq                { Dec ($1,$2,ofLexPos(parseState.InputStartPosition 2)) :: $4   }
  | Type NAME ASSIGN Expr SEMICOLON StmtOrDecSeq    { Dec ($1,$2,ofLexPos(parseState.InputStartPosition 2)) ::
                                                      Stmt(Expr(Assign(AccVar($2,None,ofLexPos(parseState.InputStartPosition 2)),
                                                                       $4,
                                                                       ofLexPos(parseState.InputStartPosition 4)))) :: $6 }
;

Stmt: 
    StmtM                               { $1 }
  | StmtU                               { $1 }
;

StmtM:  /* No unbalanced if-else */
  | Expr SEMICOLON                      { Expr $1                                                         }
  | RETURN SEMICOLON                    { Return(None,ofLexPos(parseState.InputStartPosition 1))          }
  | RETURN Expr SEMICOLON               { Return(Some($2), ofLexPos(parseState.InputStartPosition 2))     }
  | Block                               { $1                   }
  | IF LPAR Expr RPAR StmtM ELSE StmtM  { If($3, $5, $7, ofLexPos(parseState.InputStartPosition 1))       }
  | WHILE LPAR Expr RPAR StmtM          { While($3, $5, ofLexPos(parseState.InputStartPosition 1))        }
;

StmtU:
    IF LPAR Expr RPAR StmtM ELSE StmtU  { If($3, $5, $7, ofLexPos(parseState.InputStartPosition 1))       }
  | IF LPAR Expr RPAR Stmt              { If($3, $5, Block([], ofLexPos(parseState.InputStartPosition 5)),
                                             ofLexPos(parseState.InputStartPosition 1))                   }
  | WHILE LPAR Expr RPAR StmtU          { While($3, $5, ofLexPos(parseState.InputStartPosition 1))        }
;

Expr:
    Access                              { Access $1                                                              }
  | ExprNotAccess                       { $1                                                                     }

ExprNotAccess:
    Access ASSIGN Expr                  { Assign($1, $3, ofLexPos(parseState.InputStartPosition 1))        }
  | Const                               { Cst($1, None,ofLexPos(parseState.InputStartPosition 1))                }
  | NEW NAME LPAR RPAR                  { New($2, None,ofLexPos(parseState.InputStartPosition 1))                } 
  | Expr DOT NAME LPAR Exprs RPAR       { Call($1, $3, None, $5, None,ofLexPos(parseState.InputStartPosition 1)) }
  | NAME LPAR Exprs RPAR                { PrimC($1, $3, None,ofLexPos(parseState.InputStartPosition 1))          }  
  | LPAR Expr RPAR                      { $2                   }
  | NOT Expr                            { Prim1("!", $2, None,ofLexPos(parseState.InputStartPosition 2))         }
  | Expr PLUS  Expr                     { Prim2("+",  $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr MINUS Expr                     { Prim2("-",  $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr TIMES Expr                     { Prim2("*",  $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr DIV   Expr                     { Prim2("/",  $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr MOD   Expr                     { Prim2("%",  $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr EQ    Expr                     { Prim2("==", $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr NE    Expr                     { Prim2("!=", $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr GT    Expr                     { Prim2(">",  $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr LT    Expr                     { Prim2("<",  $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr GE    Expr                     { Prim2(">=", $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr LE    Expr                     { Prim2("<=", $1, $3, None,ofLexPos(parseState.InputStartPosition 2))    }
  | Expr SEQAND Expr                    { Andalso($1, $3, None,ofLexPos(parseState.InputStartPosition 2))        }
  | Expr SEQOR  Expr                    { Orelse($1, $3, None,ofLexPos(parseState.InputStartPosition 2))         }
;

Access:
    NAME                                { AccVar($1, None, ofLexPos(parseState.InputStartPosition 1))           }  // Includes this and super
  | Expr DOT NAME                       { AccFld($1, $3, None, ofLexPos(parseState.InputStartPosition 1))       }
  
Exprs:
    /* empty */                         { [] }
  | Exprs1                              { $1 }
;

Exprs1:
    Expr                                { [$1] }
  | Expr COMMA Exprs1                   { $1 :: $3 }
;

Const:
    CSTINT                              { CstI($1) }
  | MINUS CSTINT                        { CstI(- $2) }
  | CSTBOOL                             { CstB($1) }
  | CSTSTRING                           { CstS($1) }
  | NULL                                { CstN }
;

Type:
    INT                                 { TypI }
  | BOOL                                { TypB }
  | STRING                              { TypS }
  | VOID                                { TypV }
  | NAME                                { TypO($1) }
;
