<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- FsLexYacc runtime via NuGet -->    
    <PackageReference Include="FsLexYacc" Version="11.3.0" PrivateAssets="all" />
    <PackageReference Include="FsLexYacc.Runtime" Version="11.3.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="Util.fs" />
    <Compile Include="CmdLine.fs" />    
    <Compile Include="Absyn.fs" />
    <Compile Include="JPar.fs" />
    <Compile Include="JLex.fs" />
    <Compile Include="Type.fs" />
    <Compile Include="Machine.fs" />
    <Compile Include="Contcomp.fs" />
    <Compile Include="Parse.fs" />
    <Compile Include="MicroJC.fs" />    
  </ItemGroup>

  <ItemGroup>
    <!-- Source generators -->
    <FsYacc Include="JPar.fsy">
      <OtherFlags>--module JPar</OtherFlags>
    </FsYacc>

    <FsLex Include="JLex.fsl">
      <OtherFlags>--unicode</OtherFlags>
    </FsLex>
  </ItemGroup>
</Project>
